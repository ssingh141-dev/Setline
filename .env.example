# Copy this file to .env and fill in the values. Never commit .env.

# --- Used by the app (safe to ship inside the app) ---
# Supabase dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Used only by Claude / build tools. Never put these in the app. ---
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
EXPO_TOKEN=
# Optional: change before the first TestFlight build (permanent after that)
APP_BUNDLE_ID=com.setline.app

# --- Later milestones ---
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# RESEND_API_KEY=
